{
  "name": "hubbub-desktop",
  "productName": "Hubbub",
  "version": "0.1.0",
  "description": "A Mattermost-style desktop client for Nextcloud Talk with multi-server support",
  "main": "./out/main/index.js",
  "author": "Tobias Rydberg",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tobberydberg/hubbub",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobberydberg/hubbub.git"
  },
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/metropolis": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "emoji-picker-react": "^5.1.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "immer": "^11.2.10",
    "lucide-react": "^1.78.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "mock-server": "node scripts/mock-server.mjs",
    "icons": "electron scripts/render-icon.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
